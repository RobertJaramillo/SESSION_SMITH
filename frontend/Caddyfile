# Single public entrypoint: serve the built SPA and proxy the API.
:80 {
	encode gzip

	# API traffic goes to the FastAPI container.
	handle /v1/* {
		reverse_proxy api:8000
	}

	# Everything else is the SPA; unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
